{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/aitask-session-start.sh",
            "timeout": 10,
            "statusMessage": "Loading aitask events"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.codex/hooks/aitask-prompt-submit.sh",
            "timeout": 5,
            "statusMessage": "Checking aitask live monitor"
          }
        ]
      }
    ]
  }
}
