APP_ENV=development
APP_PORT=18081
WEB_PORT=13081

AITASK_ENV=development
AITASK_HTTP_HOST=0.0.0.0
AITASK_HTTP_PORT=8080
AITASK_HTTP_READ_TIMEOUT=10s
AITASK_HTTP_WRITE_TIMEOUT=30s
AITASK_HTTP_IDLE_TIMEOUT=120s
AITASK_HTTP_SHUTDOWN_TIMEOUT=10s

POSTGRES_HOST=postgres
POSTGRES_PORT=15533
POSTGRES_DB=aitask
POSTGRES_USER=aitask
POSTGRES_PASSWORD=aitask_dev_password
DATABASE_URL=postgres://aitask:aitask_dev_password@postgres:5432/aitask?sslmode=disable

DRAGONFLY_HOST=dragonfly
DRAGONFLY_PORT=16380
DRAGONFLY_PASSWORD=dragonfly_dev_password
DRAGONFLY_URL=redis://:dragonfly_dev_password@dragonfly:6379/0

AGENT_TOKEN_SECRET=dev_only_change_me
CONSOLE_OPERATOR_LABEL=local-operator

OPENVIKING_BASE_URL=http://openviking:9090
OPENVIKING_NAMESPACE=aitask

# 内网 / 单机受信部署，无需 CORS（前后端同源 nginx）

OPENVIKING_PORT=19191
